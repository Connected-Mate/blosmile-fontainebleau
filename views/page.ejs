us accompagnent.</em></h2></div><a class="text-link" href="/equipe">Toute l’équipe <%- include('partials/icon',{name:'arrow'}) %></a></div><div class="team-grid"><% practitioners.forEach(person=>{ %><%- include('partials/team-card',{person,detailed:false}) %><% }) %></div></div></section><% } %><% if(service.educationalLinks?.length){ %><section class="wrap section-space"><p class="eyebrow">POUR ALLER PLUS LOIN</p><h2>Comprendre, <em>en toute simplicité.</em></h2><div class="resource-links"><% service.educationalLinks.forEach(link=>{ %><a href="<%= resourceUrl(link) %>"><span><%= link.title %></span><%- include('partials/icon',{name:'arrow'}) %></a><% }) %></div></section><% } %><%- include('partials/contact-block') %>
