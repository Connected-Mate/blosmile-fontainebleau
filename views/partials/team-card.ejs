<article class="team-card"><div class="portrait-wrap"><img src="<%= person.image %>" alt="<%= person.name %>, <%= person.role %> à Fontainebleau" width="800" height="800" loading="lazy"><span class="portrait-mark">blosmile</span></div><div class="team-card-content"><p class="eyebrow"><%= person.role %></p><h3><%= person.name %></h3><p class="team-focus"><%= person.focus %></p><% if(typeof detailed !== 'undefined' && detailed && person.qualifications.length){ %><details class="qualifications"><summary>Parcours & formations <span>+</span></summary><ul><% person.qualifications.forEach(q=>{ %><li><%= q %></li><% }) %></ul></details><% } %></div></article>
