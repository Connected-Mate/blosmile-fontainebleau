<% const p=content.practice; %>
<footer class="footer"><div class="wrap footer-main"><div class="footer-intro"><a class="brand-crop footer-logo" href="/" aria-label="Blosmile — Accueil"><img src="<%= p.logo %>" width="505" height="480" alt="Blosmile"></a><p><%= content.copy?.footerTagline || "Votre sourire, notre attention." %><br><%= content.copy?.footerDescription || "Cabinets dentaires à Fontainebleau." %></p><span class="footer-signature"><%= content.copy?.footerSignature || "Le soin commence par la confiance." %></span></div><div><h2>Le cabinet</h2><a href="/le-cabinet">Découvrir les lieux</a><a href="/equipe">Rencontrer l’équipe</a><a href="/formations">Parcours & formations</a><a href="/contact">Préparer votre visite</a><a href="/questions-frequentes">Questions fréquentes</a><a href="/conseils">Conseils & informations</a></div><div><h2>Nos soins</h2><% content.services.forEach(s=>{ %><a href="/soins/<%= s.slug %>"><%= s.title %></a><% }) %></div><div><h2>Nous trouver</h2><% if(p.googleReviewsUrl){ %><a href="<%= p.googleReviewsUrl %>" target="_blank" rel="noopener noreferrer">Avis sur Google ↗</a><% } %><a href="/venir" class="footer-address"><%= p.address %><br><%= p.postalCode %> <%= p.city %></a><a href="tel:<%= p.phone.replace(/[^+\d]/g,'').replace(/^0/,'+33') %>" class="footer-phone"><%= p.phone %></a><a href="mailto:<%= p.email %>"><%= p.email %></a><p class="small"><%= p.hoursLabel || 'Du lundi au vendredi' %><br><%= p.hoursSummary %></p></div></div><div class="wrap footer-bottom"><span>© <%= new Date().getFullYear() %> Blosmile</span><div><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a><% if(typeof staticMode === "undefined" || !staticMode){ %><a href="/admin">Espace cabinet</a><% } %><a href="#top">Haut de page ↑</a></div></div></footer>
<div class="mobile-call"><a href="<%= p.appointmentUrl || 'tel:'+p.phone.replace(/[^+\d]/g,'').replace(/^0/,'+33') %>"><%- include('icon',{name:'phone'}) %> Prendre rendez-vous</a><a href="/venir"><%- include('icon',{name:'pin'}) %> Venir au cabinet</a></div>
