<% const p=content.practice; %><section class="contact-section" id="rendez-vous"><div class="wrap contact-grid"><div><span class="eyebrow light"><%= content.copy?.contactEyebrow || "NOUS SOMMES À VOTRE ÉCOUTE" %></span><h2><%= content.copy?.contactTitle || "Faisons le premier pas." %><br><em><%= content.copy?.contactAccent || "Ensemble." %></em></h2><p class="contact-copy"><%= content.copy?.contactDescription || "Une première visite, une question ou un suivi ? Notre secrétariat vous accompagne par téléphone." %></p><a class="contact-big-phone" href="tel:<%= p.phone.replace(/[^+\d]/g,'').replace(/^0/,'+33') %>"><%= p.phone %><%- include('icon',{name:'upRight'}) %></a><div class="contact-email"><a href="mailto:<%= p.email %>"><%= p.email %></a></div></div><div class="visit-card"><div class="visit-card-heading"><span class="round-icon"><%- include('icon',{name:'pin'}) %></span><div><h3><%= content.copy?.visitTitle || "Au cœur de Fontainebleau" %></h3><a href="/venir" class="visit-address"><%= p.address %>, <%= p.postalCode %> <%= p.city %></a></div></div><div class="opening-hours"><% p.hours.forEach(day=>{ %><div><span><%= day.day %></span><span><%= day.hours %></span></div><% }) %></div><a href="/venir" class="text-link">Adresse, itinéraires & QR code <%- include('icon',{name:'upRight'}) %></a><details class="compact-directions"><summary>Choisir une application <%- include('icon',{name:'plus'}) %></summary><%- include('directions-links') %></details><p class="visit-note"><%= content.copy?.visitNote || "Sur rendez-vous · Contactez-nous pour préparer votre venue." %></p></div></div></section>
