<% const item=content.journal.articles.find(item=>item.slug===article.slug) || article, related=content.journal.articles.filter(other=>other.slug!==item.slug && other.category===item.category).slice(0,3), treatment=content.services.find(service=>service.slug===item.category), sources=item.sources?.length ? item.sources : [{title:'Fiche du site du cabinet',url:item.sourceUrl}]; %>
<header class="page-intro wrap journal-article-intro"><p class="eyebrow">LE CARNET BLOSMILE · <%= item.categoryTitle %></p><h1><%= item.title %></h1><p><%= item.description %></p><div class="journal-article-meta"><span><%= item.readingMinutes %> min de lecture</span><span>Votre cabinet à <%= content.practice.city %></span></div></header>
<div class="wrap journal-reading-layout">
  <article class="journal-prose prose">
    <% if(item.image){ %><figure class="journal-article-figure"><img src="<%= item.image %>" alt="Illustration : <%= item.title %>" width="900" height="540" fetchpriority="high"><figcaption>Illustration du thème présenté.</figcaption></figure><% } %>
    <% item.paragraphs.forEach(text=>{ %><p><%= text %></p><% }) %>
    <% (item.sections || []).forEach(section=>{ %><section id="<%= section.id %>" class="journal-article-section"><h2><%= section.title %></h2><% section.paragraphs.forEach(text=>{ %><p><%= text %></p><% }) %></section><% }) %>
    <% if(item.consultationQuestions?.length){ %><section class="consultation-questions"><p class="eyebrow">POUR VOTRE PROCHAIN RENDEZ-VOUS</p><h2>Les questions à poser.</h2><ul><% item.consultationQuestions.forEach(question=>{ %><li><%= question %></li><% }) %></ul></section><% } %>
    <% if(item.questions?.length){ %><section class="journal-article-section"><h2>Vos questions, simplement.</h2><%- include('faq',{items:item.questions}) %></section><% } %>
    <section class="journal-local"><p class="eyebrow">VOTRE PARCOURS À <%= content.practice.city %></p><h2>Parlons de votre situation.</h2><p><%= item.localContext || 'Au cabinet Blosmile à '+content.practice.city+', un premier échange permet de préciser vos attentes et d’organiser un bilan adapté. Votre praticien vous explique les options, leurs limites et les étapes du suivi.' %></p><div class="journal-local-links"><% if(treatment){ %><a class="text-link" href="/soins/<%= treatment.slug %>">Les soins de <%= treatment.title.toLowerCase() %> <%- include('icon',{name:'arrow'}) %></a><% } %><a class="text-link" href="/equipe">Rencontrer notre équipe <%- include('icon',{name:'arrow'}) %></a><a class="text-link" href="/venir">Adresse & stationnement <%- include('icon',{name:'arrow'}) %></a></div></section>
    <p class="medical-note"><%= content.copy?.articleDisclaimer || 'Information générale : seul un examen clinique permet de définir le traitement adapté à votre situation.' %></p>
    <details class="journal-sources"><summary>Sources & informations éditoriales</summary><p>Informations consultées le <%= item.sourceDate %>. Contenu de présentation à valider par le cabinet ; aucune validation médicale nominative n’est revendiquée.</p><ul><% sources.filter(source=>source.url).forEach(source=>{ %><li><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.title %> ↗</a></li><% }) %></ul></details>
  </article>
  <aside class="journal-sidebar">
    <% if(item.sections?.length){ %><nav class="journal-toc" aria-label="Sommaire du conseil"><p class="eyebrow">DANS CE CONSEIL</p><% item.sections.forEach(section=>{ %><a href="#<%= section.id %>"><%= section.title %></a><% }) %></nav><% } %>
    <div class="appointment-aside"><span class="tiny-smile" aria-hidden="true">:)</span><h2>Une question ?<br>Parlons-en.</h2><p>Préparez votre consultation avec l’équipe Blosmile à <%= content.practice.city %>.</p><a class="button" href="tel:<%= content.practice.phoneInternational %>"><%= content.practice.phone %></a><a href="/venir"><%= content.practice.address %><br><%= content.practice.postalCode %> <%= content.practice.city %></a></div>
  </aside>
</div>
<% if(related.length){ %><section class="section-space wrap"><div class="section-heading"><div><p class="eyebrow">POUR CONTINUER</p><h2>D’autres repères,<br><em>pour vous.</em></h2></div><a class="text-link" href="/conseils">Tous les conseils <%- include('icon',{name:'arrow'}) %></a></div><div class="journal-grid"><% related.forEach(item=>{ %><%- include('journal-card',{item}) %><% }) %></div></section><% } %>
