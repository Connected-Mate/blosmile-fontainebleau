<% const copy=content.pages.formations || {}, dentists=content.team.filter(person=>person.kind==='dentist'); %>
<section class="page-intro wrap"><p class="eyebrow">PARCOURS & FORMATIONS · <%= content.practice.city %></p><h1><%= copy.title || 'Des parcours complémentaires.' %><br><em><%= copy.accent || 'Une attention commune.' %></em></h1><p><%= copy.description || 'Découvrez les diplômes et formations publiés par les chirurgiens-dentistes Blosmile, et les établissements qui jalonnent leurs parcours.' %></p></section>
<div class="wrap formation-directory"><nav class="formation-nav" aria-label="Accéder au parcours d’un praticien"><p class="eyebrow">VOS PRATICIENS</p><% dentists.forEach(person=>{ %><a href="#<%= person.id %>"><%= person.name %></a><% }) %><a class="formation-team-return" href="/equipe">Toute l’équipe <%- include('icon',{name:'arrow'}) %></a></nav><div class="formation-list">
<% dentists.forEach(person=>{ const services=content.services.filter(service=>(service.practitionerIds || []).includes(person.id)); %>
<section class="formation-profile" id="<%= person.id %>" aria-labelledby="formation-<%= person.id %>"><div class="formation-profile-heading"><img src="<%= person.image %>" alt="<%= person.name %>" width="180" height="210" loading="lazy"><div><p class="eyebrow"><%= person.role %></p><h2 id="formation-<%= person.id %>"><%= person.name %></h2><p><%= person.focus %></p></div></div>
<% if(person.education?.length){ %><h3>Diplômes & formations</h3><ul class="formation-qualifications"><% person.education.forEach(qualification=>{ %><li><span><%= qualification.title %></span><% (qualification.links || []).forEach(link=>{ %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.title %> ↗</a><% }) %></li><% }) %></ul><% } else { %><p class="formation-pending">L’équipe peut vous renseigner sur le parcours de ce praticien lors de votre prise de contact.</p><% } %>
<% if(person.institutionLinks?.length){ %><div class="formation-institutions"><% person.institutionLinks.forEach(link=>{ %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.title %> ↗</a><% }) %></div><% } %>
<% if(services.length){ %><div class="formation-care"><span>Découvrir les soins associés</span><% services.forEach(service=>{ %><a href="/soins/<%= service.slug %>"><%= service.title %> <span aria-hidden="true">↗</span></a><% }) %></div><% } %></section>
<% }) %>
</div></div>
<section class="wrap formation-note"><p><%= copy.note || 'Diplômes et formations présentés d’après les informations publiées par le cabinet. Les liens conduisent aux sites des établissements et organismes cités ; certains noms de diplômes sont historiques.' %></p><a href="<%= content.meta.sourceUrl.replace(/\/$/,'') %>/l-equipe" target="_blank" rel="noopener noreferrer">Consulter la présentation du cabinet ↗</a></section>
<%- include('contact-block') %>
